# Optional. Without a key, /api/chat uses scripted corpus search only.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Used when AI_GATEWAY_API_KEY is set. Default: openai/gpt-4.1-mini
AI_MODEL=openai/gpt-4.1-mini

# Optional Postgres + pgvector (see prisma/schema.prisma). Not required for MVP.
DATABASE_URL=

# Signs session cookies and short-lived media URLs. Set a long random value in production.
SESSION_SECRET=

# Vercel Blob (private) for the ~389MB Manzi exam image tree. Do not commit those files.
# Created automatically when a Blob store is linked on the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Optional overrides for the coordinator drop (defaults below).
# MANZI_JSONL=/workspace/taxiprov/manzi/questions-merged.jsonl
# MANZI_IMAGES=/workspace/taxiprov/manzi/images

# Android APK WebView host (defaults to lib/branding.ts native.serverUrl).
# CAPACITOR_SERVER_URL=https://taxiiii.vercel.app

# Optional future Clerk / Auth.js
# AUTH_SECRET=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
