<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <!--
          Android 15 (targetSdk 35) ignores statusBarColor / navigationBarColor and
          forces edge-to-edge. Capacitor then insets the WebView
          (android.adjustMarginsForEdgeToEdge = "auto"), so the strips behind the
          system bars show the window background. Paint it in the brand forest so
          those strips match themeColor and the splash on every Android version.
        -->
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Extra Recents / task-switcher friction on top of FLAG_SECURE. -->
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>